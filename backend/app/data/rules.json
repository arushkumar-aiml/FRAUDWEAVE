        "patterns": [
            "\\b(account|khata|connection|sim|card)\\b.{0,30}\\b(band|block(ed)?|suspend(ed)?|cut|disconnect\\w*|deactivat\\w*|restricted|locked|frozen|freeze|unfreeze)\\b",
            "\\bavoid\\b.{0,25}\\b(cut\\w*|disconnect\\w*|block\\w*|freeze|suspend\\w*|terminat\\w*)",
            "\\b(aaj raat|today only|tonight)\\b",
            "(बंद हो जाएगा|ब्लॉक|काट दी जाएगी|काट दिया जाएगा|कट जाएगा|कट जाएगी|डिस्कनेक्ट|फ्रीज|निष्क्रिय|आज रात)"
        ]
    },
    {
        "id": "KYC_UPDATE",
        "category": "kyc",
        "weight": 35,
        "strong": false,
