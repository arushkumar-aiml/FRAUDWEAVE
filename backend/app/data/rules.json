            "(केवाईसी|आधार|पैन)",
            "\\b(update|verify|complete|re-?verify|pending)\\b.{0,25}\\b(kyc|pan|aadhaar|aadhar)\\b",
            "\\b(kyc)\\b.{0,30}\\b(details|portal|penalty)\\b"
        ]
    },
    {
        "id": "OTP_PIN_REQUEST",
        "category": "general",
        "weight": 60,
        "strong": true,
        "reason": "Asks you to share/enter OTP, PIN or CVV. Banks never ask for this.",
        "patterns": [
            "\\b(share|send|enter|tell|bata\\w*|bhej\\w*|dijiye|dalein)\\b.{0,25}\\b(otp|pin|cvv)\\b",
            "\\b(otp|pin|cvv)\\b.{0,25}(daal\\w*|dale\\w*|dalein|darj)",
            "\\b(pin|otp)\\b.{0,12}\\benter (kare|karo|karke|kar)\\b",
            "(पिन|PIN|OTP).{0,25}(डाल|दर्ज)"
        ]
    },
    {
        "id": "UPI_PIN_TO_RECEIVE",
        "category": "upi_manipulation",
        "weight": 60,
        "strong": true,
        "reason": "UPI PIN is only needed to PAY, never to receive money or a refund.",
        "patterns": [
            "\\bpin\\b.{0,40}\\b(receive|refund|credit)\\b",
            "\\b(receive|refund)\\b.{0,40}\\bpin\\b"
        ]
    },
    {
